<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/prayerkey_mark" android:contentDescription="@null" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="VERSE OF THE DAY" android:textColor="#FFD68C" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.16" android:maxLines="1" />
        <ImageView android:id="@+id/walk_flame" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/widget_flame" android:contentDescription="@null" />
        <TextView android:id="@+id/walk_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:textColor="#FFD68C" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/verse" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp"
        android:gravity="center_vertical" android:fontFamily="serif" android:textColor="#FFFFFF" android:textSize="17sp" android:lineSpacingMultiplier="1.12"
        android:ellipsize="end" android:maxLines="5" />
    <TextView android:id="@+id/ref" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:fontFamily="serif" android:textStyle="italic" android:textColor="#FFD68C" android:textSize="14sp" android:maxLines="1" />
</LinearLayout>
