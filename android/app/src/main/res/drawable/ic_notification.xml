<?xml version="1.0" encoding="utf-8"?>
<!--
  PrayerKey's notification mark.

  Android deliberately ignores full-colour artwork for the small notification
  icon: it reads only the alpha silhouette and colours the surrounding disc
  from NotificationCompat.setColor(). This is therefore the praying figure
  and key from the brand mark, redrawn to survive at 18–24 px.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- head and hood -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1.5a2.35,2.35 0,1 1,0 4.7a2.35,2.35 0,0 1,0 -4.7z" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.65"
        android:strokeLineCap="round"
        android:pathData="M7.2,9.1C6.1,7.8 6.2,5.3 8.1,3.5M16.8,9.1C17.9,7.8 17.8,5.3 15.9,3.5" />

    <!-- shoulders and bowed arms -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.05"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7.5,7.1C4.5,7.8 2.8,10.1 2.5,13.5C2.2,16.2 4.4,17.7 6.3,16.1L10.2,12.2M16.5,7.1C19.5,7.8 21.2,10.1 21.5,13.5C21.8,16.2 19.6,17.7 17.7,16.1L13.8,12.2" />

    <!-- praying hands, flowing into the key shank -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9.45,8.25L10.55,7.55L12,10.15L13.45,7.55L14.55,8.25L13.35,12.15L12.9,13.05V21.9H10.8V13.05L10.35,12.15z" />

    <!-- key wards -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12.55,16.9H17.1V18.75H15.45V20.25H17.1V22.1H12.55z" />
</vector>
