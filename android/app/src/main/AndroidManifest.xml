<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Play infers required hardware from permissions. RECORD_AUDIO implies
      android.hardware.microphone as REQUIRED, and a required feature removes
      every device without it from the store listing - tablets, some
      Chromebooks, foldables in desk mode, anything Play is unsure about. Those
      users see "your device isn't compatible" and never learn why.

      The microphone is used by one screen. The Bible, the prayers, the
      devotionals, the journal and both offices do not need it, so requiring it
      to install the app is wrong.
    -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.audio.output" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Church mode listens for a whole service with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:usesCleartextTraffic="${usesCleartextTraffic}" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="PrayerKey" android:supportsRtl="true" android:theme="@style/Theme.Manna">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/share_paths" />
        </provider>
        <receiver android:name=".reminder.ReminderReceiver" android:exported="false" />
        <receiver android:name=".reminder.FastingMilestoneReceiver" android:exported="false" />
        <receiver android:name=".reminder.PrayerMemoryReceiver" android:exported="false" />
        <receiver android:name=".reminder.ReminderBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".widget.VerseWidget" android:label="@string/widget_verse_label" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_verse_info" />
        </receiver>
        <receiver android:name=".widget.WalkWidget" android:label="@string/widget_walk_label" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_walk_info" />
        </receiver>
        <receiver android:name=".widget.PrayerWidget" android:label="@string/widget_prayer_label" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_prayer_info" />
        </receiver>
        <service
            android:name=".ui.church.SermonService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
